#!/usr/bin/env bash
# kdev -- open the 3-pane dev workspace for a project.
#
#   kdev              new TAB in this kitty window, for $PWD
#   kdev ~/some/repo  ditto, for that directory
#   kdev -w [dir]     new OS WINDOW instead of a tab
#
# One tab per project is the point: kdev defaults to a tab so you can keep
# several projects side by side in one kitty window.
set -euo pipefail

want_window=0
dir=""
while [ $# -gt 0 ]; do
    case "$1" in
        -w|--window) want_window=1 ;;
        -t|--tab)    want_window=0 ;;
        -h|--help)   sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *)           dir="$1" ;;
    esac
    shift
done

dir="${dir:-$PWD}"
[ -d "$dir" ] || dir="$(dirname "$dir")"
dir="$(cd "$dir" && pwd)"
name="$(basename "$dir")"

session="${XDG_CONFIG_HOME:-$HOME/.config}/kitty/dev.session"

open_os_window() {
    [ -f "$session" ] || { echo "kdev: no session file at $session" >&2; exit 1; }
    kitty --single-instance --session "$session" --directory "$dir" >/dev/null 2>&1 &
    disown
}

open_tab() {
    # yazi on the left; claude takes 70% of the width; shell takes 30% of
    # claude's column.  --match picks the tab, --next-to picks the window
    # inside it that gets split.
    local w1 w2
    w1=$(kitten @ launch --type=tab --tab-title "$name" \
            --cwd "$dir" --window-title files yazi) || return 1
    w2=$(kitten @ launch --type=window --location=vsplit --bias 70 \
            --cwd "$dir" --window-title claude \
            --match "window_id:$w1" --next-to "id:$w1" claude) || return 1
    kitten @ launch --type=window --location=hsplit --bias 30 \
            --cwd "$dir" --window-title shell \
            --match "window_id:$w2" --next-to "id:$w2" >/dev/null || return 1
    kitten @ focus-window --match "id:$w2" >/dev/null || true
}

if [ "$want_window" -eq 1 ]; then
    open_os_window
    exit 0
fi

if [ -z "${KITTY_LISTEN_ON:-}" ]; then
    echo "kdev: kitty remote control is off, opening a new window instead." >&2
    echo "      Fully quit and relaunch kitty to enable tabs (listen_on needs a restart)." >&2
    open_os_window
    exit 0
fi

open_tab || {
    echo "kdev: could not create a tab, falling back to a new window." >&2
    open_os_window
}
