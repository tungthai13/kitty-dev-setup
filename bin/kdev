#!/usr/bin/env bash
# kdev -- open the 3-pane dev workspace for a project.
#
# This script handles the NEW TAB and NEW WINDOW forms. The plain `kdev`
# you type is a shell function (shell/dev-workspace.bash) that builds the
# layout in the tab you are already in -- a script cannot do that, because
# it cannot replace the shell that called it with Claude Code.
#
#   kdev -t [dir]   new tab in this kitty window
#   kdev -w [dir]   new OS window
set -euo pipefail

mode="tab"
dir=""
while [ $# -gt 0 ]; do
    case "$1" in
        -w|--window) mode="window" ;;
        -t|--tab)    mode="tab" ;;
        -h|--help)   sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *)           dir="$1" ;;
    esac
    shift
done

dir="${dir:-$PWD}"
[ -d "$dir" ] || dir="$(dirname "$dir")"
dir="$(cd "$dir" && pwd)"
name="$(basename "$dir")"
session="${XDG_CONFIG_HOME:-$HOME/.config}/kitty/dev.session"

open_os_window() {
    [ -f "$session" ] || { echo "kdev: no session file at $session" >&2; exit 1; }
    kitty --single-instance --session "$session" --directory "$dir" >/dev/null 2>&1 &
    disown
}

open_tab() {
    local w1 w2
    w1=$(kitten @ launch --type=tab --tab-title "$name" \
            --cwd "$dir" --window-title files yazi) || return 1
    w2=$(kitten @ launch --type=window --location=vsplit --bias 70 \
            --cwd "$dir" --window-title claude \
            --match "window_id:$w1" --next-to "id:$w1" claude) || return 1
    kitten @ launch --type=window --location=hsplit --bias 30 \
            --cwd "$dir" --window-title shell \
            --match "window_id:$w2" --next-to "id:$w2" >/dev/null || return 1
    kitten @ focus-window --match "id:$w2" >/dev/null || true
}

if [ "$mode" = "window" ] || [ -z "${KITTY_LISTEN_ON:-}" ]; then
    [ "$mode" = "tab" ] && {
        echo "kdev: kitty remote control is off -- opening a window instead." >&2
        echo "      Fully quit and relaunch kitty (listen_on needs a restart)." >&2
    }
    open_os_window
    exit 0
fi

open_tab || { echo "kdev: tab failed, using a new window." >&2; open_os_window; }
