# ~/.config/kitty/dev.session -- launched by `kdev` (see shell/dev-workspace.bash)
# Layout:  [ yazi | claude 70% ]
#                 [ shell  30% ]
# --bias is the fraction taken by the window BEING LAUNCHED.
new_tab dev
layout splits

launch --title files yazi

launch --location=vsplit --bias 70 --title claude claude

launch --location=hsplit --bias 30 --title shell

focus_matching_window title:claude
