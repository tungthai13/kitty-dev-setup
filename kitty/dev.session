# ~/.config/kitty/dev.session -- launched by `kdev` (see .bashrc)
# Layout:  [ yazi 30% | claude 70% ]
#                     [ shell      ]
new_tab dev
layout splits

launch --title files --bias 30 yazi

launch --location=vsplit --title claude claude

launch --location=hsplit --bias 70 --title shell

# Focus the claude pane on open
focus_matching_window title:claude
